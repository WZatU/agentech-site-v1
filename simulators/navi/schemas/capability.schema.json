{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://navi.local/schemas/capability.schema.json",
  "title": "Navi MuJoCo Backend Capability Registry",
  "type": "object",
  "required": ["schema_version", "canonical_method_count", "entries"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "canonical_method_count": {"const": 117},
    "entries": {
      "type": "array",
      "minItems": 117,
      "maxItems": 117,
      "items": {
        "type": "object",
        "required": [
          "method", "category", "status", "backend_behavior_status",
          "sdk_contract_status", "ground_truth_status", "evidence_status",
          "reason", "limitations", "physical_execution"
        ],
        "properties": {
          "method": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "status": {
            "type": "string",
            "deprecated": true,
            "description": "Compatibility field derived from the four-axis status model."
          },
          "backend_behavior_status": {
            "enum": [
              "PHYSICALLY_IMPLEMENTED", "SIMULATED", "APPROXIMATE",
              "NO_MEANINGFUL_MOTION", "BLOCKED_BY_MODEL", "HARDWARE_ONLY",
              "UNAVAILABLE", "UNSAFE_PROVEN", "FAILED"
            ]
          },
          "sdk_contract_status": {
            "enum": [
              "RESOLVED", "PARTIALLY_RESOLVED", "RETURN_UNRESOLVED",
              "BLOCKING_UNRESOLVED", "ASYNC_UNRESOLVED",
              "MULTIPLE_UNRESOLVED", "NOT_APPLICABLE"
            ]
          },
          "ground_truth_status": {
            "enum": [
              "DIRECT_CONFIRMED", "LEGACY_CONFIRMED", "INFERRED",
              "AMBIGUOUS", "CONFLICT", "UNMATCHED", "NOT_APPLICABLE"
            ]
          },
          "evidence_status": {
            "enum": [
              "VERIFIED", "VERIFIED_WITH_LIMITATIONS",
              "INSUFFICIENT", "CONTRADICTED"
            ]
          },
          "reason": {"type": "string", "minLength": 1},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "physical_execution": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
