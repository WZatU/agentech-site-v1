<mujoco model="Navi quadruped scene">
  <compiler angle="radian" coordinate="local" meshdir="." autolimits="true"
            inertiafromgeom="false"/>
  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast"
          solver="Newton" iterations="60" tolerance="1e-10"
          cone="elliptic" impratio="5"/>
  <size njmax="1000" nconmax="200"/>
  <statistic center="0 0 0.16" extent="0.9"/>

  <visual>
    <headlight diffuse="0.55 0.55 0.55" ambient="0.25 0.25 0.25" specular="0.2 0.2 0.2"/>
    <rgba haze="0.12 0.15 0.19 1"/>
    <global azimuth="135" elevation="-22"/>
  </visual>

  <default>
    <default class="navi">
      <joint type="hinge" limited="true" damping="0.15" armature="0.002" frictionloss="0.015"/>
      <geom condim="4" friction="0.8 0.01 0.0005" solref="0.015 1" solimp="0.9 0.97 0.002"/>
      <site group="4"/>
      <default class="abad_joint">
        <joint damping="0.12" armature="0.002" frictionloss="0.015"/>
      </default>
      <default class="hip_joint">
        <joint damping="0.20" armature="0.003" frictionloss="0.02"/>
      </default>
      <default class="knee_joint">
        <joint damping="0.14" armature="0.002" frictionloss="0.015"/>
      </default>
      <default class="visual">
        <geom contype="0" conaffinity="0" group="1" density="0"/>
      </default>
      <default class="body_collision">
        <geom contype="2" conaffinity="1" group="3" rgba="0.2 0.35 0.9 0.16"
              friction="0.65 0.01 0.0005"/>
      </default>
      <default class="limb_collision">
        <geom contype="2" conaffinity="1" group="3" rgba="0.25 0.55 0.85 0.10"
              friction="0.75 0.01 0.0005"/>
      </default>
      <default class="foot_collision">
        <geom contype="2" conaffinity="1" group="3" rgba="0.05 0.05 0.05 0.55"
              condim="6" friction="1.15 0.025 0.002" solref="0.010 1" solimp="0.92 0.98 0.001"/>
      </default>
    </default>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.16 0.18 0.20" rgb2="0.27 0.29 0.31"/>
    <material name="ground_material" texture="grid" texrepeat="8 8" texuniform="true"
              reflectance="0.1" rgba="0.9 0.9 0.9 1"/>
    <material name="body_material" rgba="0.70 0.72 0.76 1"/>
    <material name="abad_material" rgba="0.80 0.72 0.18 1"/>
    <material name="limb_material" rgba="0.62 0.65 0.70 1"/>
    <material name="foot_material" rgba="0.08 0.08 0.09 1"/>
    <mesh name="base_link" file="meshes/base_link.STL"/>
    <mesh name="abad_link" file="meshes/abad_link.STL"/>
    <mesh name="abad_link_mirror_y" file="meshes/abad_link_mirror_y.STL"/>
    <mesh name="abad_link_mirror_x" file="meshes/abad_link_mirror_x.STL"/>
    <mesh name="abad_link_mirror_xy" file="meshes/abad_link_mirror_xy.STL"/>
    <mesh name="hip_link" file="meshes/hip_link.STL"/>
    <mesh name="hip_link_mirror_y" file="meshes/hip_link_mirror_y.STL"/>
    <mesh name="knee_link" file="meshes/knee_link.STL"/>
    <mesh name="knee_link_mirror_y" file="meshes/knee_link_mirror_y.STL"/>
    <mesh name="foot_link" file="meshes/foot_link.STL"/>
  </asset>

  <worldbody>
    <geom name="ground" type="plane" size="6 6 0.05" material="ground_material"
          contype="1" conaffinity="2" condim="6" friction="0.95 0.02 0.001"
          solref="0.015 1" solimp="0.9 0.98 0.001"/>
    <light name="key_light" pos="1.5 -2.5 3.5" dir="-0.2 0.4 -1" directional="true"/>
    <light name="fill_light" pos="-2 1.5 2.5" dir="0.4 -0.2 -1" directional="true"
           diffuse="0.35 0.42 0.5"/>
    <camera name="track" mode="trackcom" pos="0.9 -1.2 0.65" xyaxes="0.8 0.6 0 -0.22 0.29 0.93"/>
    <camera name="side" pos="0 -1.5 0.4" xyaxes="1 0 0 0 0.25 0.97"/>
    <camera name="front" pos="1.2 0 0.4" xyaxes="0 1 0 -0.25 0 0.97"/>
    <include file="robot.xml"/>
  </worldbody>

  <actuator>
    <motor name="front_left_abad_joint_motor" joint="front_left_abad_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="front_left_hip_joint_motor" joint="front_left_hip_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="front_left_knee_joint_motor" joint="front_left_knee_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="front_right_abad_joint_motor" joint="front_right_abad_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="front_right_hip_joint_motor" joint="front_right_hip_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="front_right_knee_joint_motor" joint="front_right_knee_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="hind_left_abad_joint_motor" joint="hind_left_abad_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="hind_left_hip_joint_motor" joint="hind_left_hip_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="hind_left_knee_joint_motor" joint="hind_left_knee_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="hind_right_abad_joint_motor" joint="hind_right_abad_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="hind_right_hip_joint_motor" joint="hind_right_hip_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
    <motor name="hind_right_knee_joint_motor" joint="hind_right_knee_joint" ctrllimited="true" ctrlrange="-9.1 9.1" gear="1"/>
  </actuator>

  <sensor>
    <framepos name="base_position" objtype="body" objname="body"/>
    <framequat name="base_orientation" objtype="body" objname="body"/>
    <framelinvel name="base_linear_velocity" objtype="body" objname="body"/>
    <frameangvel name="base_angular_velocity" objtype="body" objname="body"/>
    <accelerometer name="imu_accelerometer" site="imu_site"/>
    <gyro name="imu_gyro" site="imu_site"/>
    <jointpos name="front_left_abad_joint_position" joint="front_left_abad_joint"/>
    <jointvel name="front_left_abad_joint_velocity" joint="front_left_abad_joint"/>
    <jointpos name="front_left_hip_joint_position" joint="front_left_hip_joint"/>
    <jointvel name="front_left_hip_joint_velocity" joint="front_left_hip_joint"/>
    <jointpos name="front_left_knee_joint_position" joint="front_left_knee_joint"/>
    <jointvel name="front_left_knee_joint_velocity" joint="front_left_knee_joint"/>
    <jointpos name="front_right_abad_joint_position" joint="front_right_abad_joint"/>
    <jointvel name="front_right_abad_joint_velocity" joint="front_right_abad_joint"/>
    <jointpos name="front_right_hip_joint_position" joint="front_right_hip_joint"/>
    <jointvel name="front_right_hip_joint_velocity" joint="front_right_hip_joint"/>
    <jointpos name="front_right_knee_joint_position" joint="front_right_knee_joint"/>
    <jointvel name="front_right_knee_joint_velocity" joint="front_right_knee_joint"/>
    <jointpos name="hind_left_abad_joint_position" joint="hind_left_abad_joint"/>
    <jointvel name="hind_left_abad_joint_velocity" joint="hind_left_abad_joint"/>
    <jointpos name="hind_left_hip_joint_position" joint="hind_left_hip_joint"/>
    <jointvel name="hind_left_hip_joint_velocity" joint="hind_left_hip_joint"/>
    <jointpos name="hind_left_knee_joint_position" joint="hind_left_knee_joint"/>
    <jointvel name="hind_left_knee_joint_velocity" joint="hind_left_knee_joint"/>
    <jointpos name="hind_right_abad_joint_position" joint="hind_right_abad_joint"/>
    <jointvel name="hind_right_abad_joint_velocity" joint="hind_right_abad_joint"/>
    <jointpos name="hind_right_hip_joint_position" joint="hind_right_hip_joint"/>
    <jointvel name="hind_right_hip_joint_velocity" joint="hind_right_hip_joint"/>
    <jointpos name="hind_right_knee_joint_position" joint="hind_right_knee_joint"/>
    <jointvel name="hind_right_knee_joint_velocity" joint="hind_right_knee_joint"/>
    <actuatorfrc name="front_left_abad_joint_force" actuator="front_left_abad_joint_motor"/>
    <actuatorfrc name="front_left_hip_joint_force" actuator="front_left_hip_joint_motor"/>
    <actuatorfrc name="front_left_knee_joint_force" actuator="front_left_knee_joint_motor"/>
    <actuatorfrc name="front_right_abad_joint_force" actuator="front_right_abad_joint_motor"/>
    <actuatorfrc name="front_right_hip_joint_force" actuator="front_right_hip_joint_motor"/>
    <actuatorfrc name="front_right_knee_joint_force" actuator="front_right_knee_joint_motor"/>
    <actuatorfrc name="hind_left_abad_joint_force" actuator="hind_left_abad_joint_motor"/>
    <actuatorfrc name="hind_left_hip_joint_force" actuator="hind_left_hip_joint_motor"/>
    <actuatorfrc name="hind_left_knee_joint_force" actuator="hind_left_knee_joint_motor"/>
    <actuatorfrc name="hind_right_abad_joint_force" actuator="hind_right_abad_joint_motor"/>
    <actuatorfrc name="hind_right_hip_joint_force" actuator="hind_right_hip_joint_motor"/>
    <actuatorfrc name="hind_right_knee_joint_force" actuator="hind_right_knee_joint_motor"/>
  </sensor>

  <keyframe>
    <key name="standing" qpos="0 0 0.276256 1 0 0 0 0 -0.55 1.10 0 -0.55 1.10 0 -0.55 1.10 0 -0.55 1.10"/>
    <key name="crouched" qpos="0 0 0.240007 1 0 0 0 0 -0.75 1.50 0 -0.75 1.50 0 -0.75 1.50 0 -0.75 1.50"/>
    <key name="test" qpos="0 0 0.268101 1 0 0 0 0 -0.60 1.20 0 -0.60 1.20 0 -0.60 1.20 0 -0.60 1.20"/>
  </keyframe>
</mujoco>
