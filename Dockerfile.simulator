FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    MUJOCO_GL=egl

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
      libegl1 \
      libgl1 \
      libglib2.0-0 \
      libglvnd0 \
      libglx0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN pip install --no-cache-dir \
      fastapi>=0.115 \
      "uvicorn[standard]>=0.30" \
      pydantic>=2 \
      mujoco>=3.2 \
      pillow>=10

COPY simulators ./simulators

RUN pip install --no-cache-dir \
      ./simulators/aegis \
      ./simulators/navi

EXPOSE 8000

CMD ["sh", "-c", "uvicorn simulators.service.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
