[Unit]
Description=Agentech Master website camera optimizers
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/run/.local/share/agentech/master_camera_web_optimizer.py

[Service]
Type=simple
ExecStart=/home/run/.local/share/agentech/start-master-camera-web.sh
Restart=always
RestartSec=2
TimeoutStopSec=10
KillMode=control-group
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
